# /etc/pam.d/greetd sur la cle live (#26870) : la connexion passe UNIQUEMENT
# par le QR. pam_unix ne sert qu'au compte (l'usager vient d'etre cree).
auth     required  pam_bfos.so
account  required  pam_unix.so
session  required  pam_bfos.so
-session optional  pam_systemd.so
session  required  pam_unix.so
