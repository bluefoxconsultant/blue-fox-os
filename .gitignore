# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Build artifacts
*.iso
*.iso.sig
*.iso.sha256
build/
dist/
*.rpm

# BlueBuild local builds
output/

# Cosign : ONLY exclude private key. cosign.pub MUST be committed
# (BlueBuild + clients use it for `cosign verify`).
cosign.key

# GPG keys (NEVER commit)
*.gpg
*.asc

# Tenant configs : vivent cote serveur, pas dans le repo.
# Exceptions : schema, exemple, et bf.json (BF est le tenant lead du projet
# OSS et son manifeste ne contient que des URLs publiques).
config/*.json
!config/schema.v1.json
!config/_example.json
!config/bf.json

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
