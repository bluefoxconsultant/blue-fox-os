# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Build artifacts
*.iso
*.iso.sig
*.iso.sha256
build/
dist/
*.rpm

# BlueBuild local builds
output/
# Dossiers de scripts temporaires que bluebuild depose a la racine du depot
# pendant un build. ⚠️ Sans cette regle, un dossier laisse par un build
# precedent rend l'arbre sale et fait REFUSER la publication suivante par le
# controle d'arbre de publish-image.sh (#23810).
/.bluebuild-scripts_*

# SBOM genere par scripts/publish-image.sh a la racine (sbom-<slug>.spdx.json).
# Non commite : c'est l'attestation cosign qui le rend verifiable, pas le repo.
# Et un artefact laisse en place ferait echouer le controle d'arbre propre du
# publish suivant.
sbom-*.spdx.json

# Cosign : ONLY exclude private key. cosign.pub MUST be committed
# (BlueBuild + clients use it for `cosign verify`).
cosign.key

# GPG keys (NEVER commit)
*.gpg
*.asc
# ⚠️ Exception : la cle PUBLIQUE linux-surface est epinglee a dessein (#23812).
# La regle ci-dessus vise les cles PRIVEES ; une ancre de confiance, elle, doit
# vivre en depot et se relire dans l'historique. Sans cette negation, `git add`
# la SAUTE en silence quand on ajoute le dossier — le build passe en local et
# casse au premier clone frais.
!files/scripts/keys/linux-surface.asc

# Tenant configs : vivent cote serveur, pas dans le repo.
# Exceptions : schema, exemple, et bf.json (BF est le tenant lead du projet
# OSS et son manifeste ne contient que des URLs publiques).
config/*.json
!config/schema.v1.json
!config/_example.json
!config/bf.json
!config/factice.json
!config/bf-surface.json

# KDE theme assets generes par scripts/generate_kde_theme.py a partir de
# tenant.json. Materialises a chaque build, pas commits.
files/etc/xdg/kdeglobals
files/etc/xdg/kscreenlockerrc
files/etc/skel/
files/etc/plasmalogin.conf.d/
files/etc/plasmalogin.conf
files/etc/sddm.conf.d/
# ⚠️ Le 2026-09-13, la ligne plasmalogin manquait : le staging du PREMIER
# locataire a salit `git status`, et publish-image.sh a refuse net les deux
# suivants — un locataire plus loin que sa cause. Tout chemin ecrit par
# scripts/generate_kde_theme.py doit figurer ici, un test le verifie en
# faisant tourner l'emetteur plutot qu'en relisant cette liste.
files/usr/share/color-schemes/
files/usr/share/wallpapers/
# files/usr/share/plasma/look-and-feel/ et /icons/* sont générés par
# scripts/generate_kde_theme.py ; files/usr/share/plasma/plasma-welcome/
# est hand-written (intégration Plasma Welcome BFOS, #22423).
files/usr/share/plasma/look-and-feel/
files/usr/share/sddm/themes/
files/usr/share/plymouth/themes/
files/usr/share/icons/bluefox-*/
files/etc/plymouth/
# Branding assets fetches par build_branded_iso.sh (logo/wallpaper/splash).
files/usr/share/bluefox/branding/
files/usr/share/bluefox/tenant.json

# Copie de install/bfos_apply.py stagee par publish-image.sh pour que
# bluefox-policy-sync reutilise son rendu des listes Flatpak. Non commitee :
# une deuxieme copie en depot finirait par deriver de l'originale.
files/usr/lib/bluefox/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
