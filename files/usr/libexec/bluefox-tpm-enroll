#!/usr/bin/env bash
# bluefox-tpm-enroll — lie le volume LUKS au TPM2 pour un deverrouillage
# automatique au demarrage, pilote par la policy Odoo (bf-policy/v2).
#
# POURQUOI UN SERVICE ROOT ET PAS UN apply_* DE L'AGENT WELCOME
# `systemd-cryptenroll` doit tourner en root, alors que l'agent welcome tourne
# en tant que l'usager, dans sa session (lanceur /etc/xdg/autostart).
# ⚠️ CE COMMENTAIRE CITAIT firstboot.service COMME PREUVE, jusqu'au 2026-09-14 —
# et c'est precisement cette unite qui lancait l'agent EN ROOT, avant toute
# session. Elle est retiree ; l'affirmation est desormais vraie. Passer par
# pkexec depuis Qt donnerait une elevation sans tty, et systemd-cryptenroll a
# besoin de lire la phrase de passe existante. On reste donc dans une unite
# root, qui demande la phrase via `systemd-ask-password` — l'agent de mot de
# passe de KDE affiche alors une vraie boite de dialogue dans la session.
#
# CE QUE LE REGLAGE VEUT DIRE, ET CE QU'IL COUTE
# Enrolement SANS NIP (choix explicite d'Olivier, 2026-07-19) : le disque se
# deverrouille des qu'on allume la machine. Quiconque a le portable arrive a
# l'ecran de connexion avec le chiffrement deja leve ; la protection au repos
# repose alors sur le seul mot de passe de session. La phrase de passe reste
# enrolee comme methode de secours — `systemd-cryptenroll --tpm2-device`
# AJOUTE un keyslot, il n'en retire jamais.
#
# PCR 7 par defaut = etat du Secure Boot. Survit aux mises a jour de noyau et
# de firmware ; si Secure Boot est desactive, le TPM refuse de rendre la cle et
# la machine redemande la phrase de passe. C'est le comportement voulu.
#
# Idempotent : si un jeton systemd-tpm2 existe deja sur le volume, on ne
# reenrole pas ; on s'assure seulement que l'option de demarrage est posee
# (#28056). Passe a CHAQUE demarrage : la policy peut etre activee apres coup
# depuis Odoo sans retoucher a la machine, et un poste enrole au %post sans
# l'option (v1.0.2) se repare au premier demarrage qui suit la mise a jour.

set -euo pipefail

# Chemins surchargeables par les essais seulement (scripts/tests) : l'unite
# n'en passe aucun.
PROV="${BFOS_PROV:-/var/lib/bluefox-welcome/provisioning.json}"
STATE_DIR="${BFOS_STATE_DIR:-/var/lib/bluefox-welcome}"
CRYPTTAB="${BFOS_CRYPTTAB:-/etc/crypttab}"
CMDLINE="${BFOS_CMDLINE:-/proc/cmdline}"
BOOT_ID="${BFOS_BOOT_ID:-/proc/sys/kernel/random/boot_id}"
SENTINEL="${STATE_DIR}/tpm-enrolled"
KARGS_POSES="${STATE_DIR}/tpm-kargs-poses"
LOG_TAG="bluefox-tpm-enroll"

log()  { logger -t "$LOG_TAG" -- "$*"; echo "[tpm-enroll] $*"; }
warn() { logger -t "$LOG_TAG" -p user.warning -- "$*"; echo "[tpm-enroll] ATTENTION: $*" >&2; }

[ "$(id -u)" -eq 0 ] || { warn "doit tourner en root"; exit 1; }

# --- 1. la policy demande-t-elle l'auto-deverrouillage ? --------------------
if [ ! -r "$PROV" ]; then
    log "pas de policy stagee (${PROV}) — rien a faire"
    exit 0
fi

read_policy() {
    # Sortie : "<enabled> <pcrs>". python3 est garanti present (agent welcome).
    python3 - "$PROV" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("false 7"); sys.exit(0)
t = (d.get("policies") or {}).get("tpm_autounlock") or {}
print("%s %s" % ("true" if t.get("enabled") else "false", t.get("pcrs") or "7"))
PY
}

read -r ENABLED PCRS <<< "$(read_policy)"
if [ "$ENABLED" != "true" ]; then
    log "policy: tpm_autounlock desactive — rien a faire"
    exit 0
fi
log "policy: tpm_autounlock actif, PCR ${PCRS}"

# --- 2. la machine a-t-elle un TPM2 utilisable ? ----------------------------
if ! systemd-analyze has-tpm2 >/dev/null 2>&1; then
    warn "aucun TPM2 utilisable sur cette machine — on garde la phrase de passe"
    exit 0
fi

# --- 3. trouver le volume LUKS de la racine --------------------------------
# On part de /etc/crypttab, ecrit par Anaconda a l'installation. Format :
#   <nom>  UUID=<uuid>  <keyfile>  <options>
if [ ! -r "$CRYPTTAB" ]; then
    warn "${CRYPTTAB} illisible — impossible de localiser le volume chiffre"
    exit 0
fi
CRYPT_NAME=$(awk '!/^[[:space:]]*#/ && NF {print $1; exit}' "$CRYPTTAB")
CRYPT_SRC=$(awk  '!/^[[:space:]]*#/ && NF {print $2; exit}' "$CRYPTTAB")
if [ -z "${CRYPT_NAME:-}" ] || [ -z "${CRYPT_SRC:-}" ]; then
    warn "aucune entree exploitable dans /etc/crypttab"
    exit 0
fi
case "$CRYPT_SRC" in
    UUID=*) DEV="/dev/disk/by-uuid/${CRYPT_SRC#UUID=}" ;;
    *)      DEV="$CRYPT_SRC" ;;
esac
[ -b "$DEV" ] || [ -n "${BFOS_DEV_FACTICE:-}" ] || { warn "peripherique ${DEV} introuvable"; exit 0; }
log "volume LUKS : ${CRYPT_NAME} -> ${DEV}"

# --- l'option qui rend le jeton visible a l'initramfs (#28056) --------------
# 🔴 Mesure en VM le 2026-11-24 (v1.0.2, poste labo et amorce) : jeton enrole,
# crypttab a jour, et le disque redemandait sa phrase. Sur ostree, l'initramfs
# est celui de l'image, sans /etc/crypttab ; il ne lit que les arguments du
# noyau. On pose donc rd.luks.options=<UUID>=tpm2-device=auto par
# `rpm-ostree kargs`, que chaque mise a jour reprend. Remplace
# `rpm-ostree initramfs-etc --track`, qui regenerait l'initramfs localement a
# chaque mise a jour pour une seule ligne.
# Garde-fous : rien si l'option est deja active ; un seul essai par demarrage
# (rpm-ostree kargs cree un deploiement a chaque appel) ; un echec ne pose pas
# le marqueur et se rejoue au demarrage suivant.
option_tpm() {
    # $1 = arguments du noyau, $2 = UUID LUKS. Rend sur stdout :
    #   ACTIVE        l'option tpm2-device=auto vaut deja pour ce volume ;
    #   CONFLIT       une option propre a ce volume existe, sans tpm2 : on ne
    #                 la reecrit pas (un administrateur l'a voulue) ;
    #   AJOUT <arg>   l'argument a poser. Il reprend les options generiques :
    #                 une option propre au volume REMPLACE les generiques dans
    #                 le generateur, et les perdrait sinon.
    # Analyse jeton par jeton, sans regex sur la ligne entiere : une option
    # d'un AUTRE volume (rd.luks.options=<autre>=…,tpm2-device=auto) ne doit
    # pas compter pour celui-ci (relecture adverse, #28056).
    local mot val per="" gen="" a_per=0 a_gen=0
    for mot in $1; do
        case "$mot" in
            rd.luks.options=*) val=${mot#rd.luks.options=} ;;
            *) continue ;;
        esac
        # <UUID>=<options> vise un volume ; sinon ce sont des options
        # generiques, qui peuvent elles-memes contenir un « = »
        # (tpm2-device=auto) : c'est la forme de la cle qui tranche.
        if [[ "${val%%=*}" =~ ^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]+)+$ ]] && [ "${val#*=}" != "$val" ]; then
            if [ "${val%%=*}" = "$2" ]; then per=${val#*=}; a_per=1; fi
        else
            gen=$val; a_gen=1
        fi
    done
    if [ "$a_per" = 1 ]; then
        case ",$per," in *,tpm2-device=auto,*) echo ACTIVE ;; *) echo CONFLIT ;; esac
        return 0
    fi
    if [ "$a_gen" = 1 ]; then
        case ",$gen," in *,tpm2-device=auto,*) echo ACTIVE; return 0 ;; esac
        echo "AJOUT rd.luks.options=$2=${gen:+$gen,}tpm2-device=auto"
        return 0
    fi
    echo "AJOUT rd.luks.options=$2=tpm2-device=auto"
}

assurer_kargs() {
    local uuid verdict opt boot ajout=()
    uuid=$(cryptsetup luksUUID "$DEV" 2>/dev/null || true)
    if [ -z "$uuid" ]; then
        warn "UUID LUKS illisible — option de demarrage non posee"
        return 0
    fi
    verdict=$(option_tpm "$(cat "$CMDLINE" 2>/dev/null)" "$uuid")
    case "$verdict" in
        ACTIVE)  log "option de demarrage tpm2-device=auto active"; return 0 ;;
        CONFLIT) warn "rd.luks.options=${uuid}=… existe sans tpm2-device=auto : non modifiee, la phrase sera demandee"
                 return 0 ;;
    esac
    opt=${verdict#AJOUT }
    boot=$(cat "$BOOT_ID" 2>/dev/null || echo inconnu)
    if [ -f "$KARGS_POSES" ] && [ "$(cat "$KARGS_POSES" 2>/dev/null)" = "$boot" ]; then
        log "option deja posee a ce demarrage-ci — effet au prochain redemarrage"
        return 0
    fi
    # Sans rd.luks.uuid (ou rd.luks.name) pour ce volume, le generateur ne cree
    # pas d'unite et rd.luks.options resterait lettre morte.
    tr ' ' '\n' < "$CMDLINE" | grep -qE "^rd\.luks\.(uuid|name)=(luks-)?${uuid}([= ]|$)" \
        || ajout+=("--append-if-missing=rd.luks.uuid=${uuid}")
    ajout+=("--append-if-missing=${opt}")
    if rpm-ostree kargs "${ajout[@]}" >/dev/null 2>&1; then
        mkdir -p "$STATE_DIR"; printf '%s\n' "$boot" > "$KARGS_POSES"
        log "option ${opt} posee — le deverrouillage par TPM prend effet au prochain redemarrage"
    else
        warn "rpm-ostree kargs a echoue — nouvel essai au prochain demarrage"
    fi
}

# --- 4. deja enrole ? -------------------------------------------------------
if cryptsetup luksDump "$DEV" 2>/dev/null | grep -q "systemd-tpm2"; then
    log "un jeton systemd-tpm2 existe deja"
    mkdir -p "$STATE_DIR"; : > "$SENTINEL"
    # Les installations v1.0.2 arrivent ici : jeton pose au %post, option de
    # demarrage jamais posee (#28056).
    assurer_kargs
    exit 0
fi

# --- 5. obtenir la phrase de passe existante --------------------------------
# systemd-ask-password passe par l'agent de mot de passe : boite de dialogue
# dans la session graphique, invite sur la console sinon.
# La phrase transite par une variable d'environnement lue par
# systemd-cryptenroll ($PASSWORD, documente dans sa page de manuel). Elle
# n'est jamais journalisee ni ecrite sur disque.
PASSWORD=$(systemd-ask-password --timeout=120 --icon=drive-harddisk \
    "Blue Fox OS — phrase de passe du disque, pour activer le deverrouillage par TPM :" 2>/dev/null || true)
if [ -z "${PASSWORD:-}" ]; then
    warn "aucune phrase de passe saisie — enrolement reporte au prochain demarrage"
    exit 0
fi
export PASSWORD

# --- 6. enrolement ----------------------------------------------------------
if ! systemd-cryptenroll "$DEV" --tpm2-device=auto --tpm2-pcrs="$PCRS" 2>&1 \
        | sed 's/^/[cryptenroll] /'; then
    unset PASSWORD
    warn "echec de l'enrolement TPM2 — la phrase de passe reste seule methode"
    exit 1
fi
unset PASSWORD
log "enrolement TPM2 reussi (PCR ${PCRS})"

# --- 7. rendre l'option visible au demarrage --------------------------------
# Le crypttab garde l'option (lisible, et c'est ce qu'un administrateur ira
# lire), mais c'est l'argument du noyau qui compte : voir assurer_kargs.
if ! grep -qE "^[[:space:]]*${CRYPT_NAME}\b.*tpm2-device=auto" "$CRYPTTAB"; then
    cp -a "$CRYPTTAB" "${CRYPTTAB}.bak-$(date +%Y%m%d%H%M%S)"
    awk -v name="$CRYPT_NAME" '
        !/^[[:space:]]*#/ && $1 == name {
            if (NF < 4 || $4 == "none" || $4 == "-") { $4 = "tpm2-device=auto" }
            else { $4 = $4 ",tpm2-device=auto" }
        }
        { print }
    ' "$CRYPTTAB" > "${CRYPTTAB}.new" && mv "${CRYPTTAB}.new" "$CRYPTTAB"
    log "${CRYPTTAB} : option tpm2-device=auto ajoutee (sauvegarde conservee)"
fi
assurer_kargs

mkdir -p "$STATE_DIR"; : > "$SENTINEL"
log "termine"
