#!/usr/bin/env python3
"""bluefox-policy-sync — re-tire la politique Odoo sur une machine deja installee.

POURQUOI CE SERVICE EXISTE (#23909)
Jusqu'ici une machine recevait sa politique UNE fois, pendant son installation,
avec le porteur OIDC de la personne qui installait. Modifier la politique dans
Odoo ne changeait donc rien sur les postes deja en service : il fallait
reinstaller. Ce service ferme la boucle. Il s'authentifie avec le secret propre
a la machine, ecrit a l'enrolement dans /etc/bluefox/machine.json (0600, root),
et reecrit la politique locale.

CE QU'IL APPLIQUE, ET CE QU'IL LAISSE TRANQUILLE
  1. /var/lib/bluefox-welcome/provisioning.json — la politique elle-meme.
     Tout ce qui relit ce fichier a chaque demarrage suit alors gratuitement :
     bluefox-tpm-enroll.service, par exemple, active l'auto-deverrouillage LUKS
     si la politique vient de l'activer, sans une ligne de plus ici.
  2. Les deux listes Flatpak /etc/bluebuild/default-flatpaks/system/{install,remove}.
  3. La copie EXPURGEE de la politique (policy-public.json, 0644), la seule que
     l'agent de session peut lire. 🔴 Jusqu'au 2026-09-23 elle n'etait ecrite
     qu'a l'installation : la session relisait donc la politique du premier
     jour, et un changement fait dans Odoo (PWA, extensions du navigateur)
     n'atteignait jamais le profil de la personne. Elle est rendue par la meme
     fonction qu'a l'installation (`render_public_policy`), secrets retires.
  4. Le verrouillage d'ecran (#27109), /etc/xdg/kscreenlockerrc, d'apres
     policies.auto_lock_minutes : n de 1 a 1440 impose le verrouillage apres n
     minutes d'inactivite, groupe [Daemon][$i] (immuable, grise dans les
     Parametres) ; 0 rend la main a la personne ; cle absente ou invalide, le
     fichier reste tel quel. Le fichier est regenere depuis la base de l'image
     (/usr/etc/xdg/kscreenlockerrc, qui porte le fond de l'ecran) : une
     alteration locale est defaite au passage suivant et notee « reglage local
     retabli » dans policy-sync.json. A CHAUD : l'unite usager
     bluefox-lock-reload.path voit le fichier changer et demande a l'ecran de
     verrouillage de relire sa configuration ; ce service-ci ne peut pas le
     faire lui-meme (root, ProtectHome=yes, hors de la session).
     Impose et retabli, pas inviolable : un sudoer reecrit le fichier jusqu'au
     passage suivant, et une application peut inhiber le verrouillage
     (lecture video, presentation, applet Energie).

Le reste du bloc « install » — nom d'hote, locale, disposition clavier, mode de
connexion — n'est DELIBEREMENT pas reapplique. Ces reglages se posent sur un
systeme qu'on installe, pas sur un systeme qui tourne : changer le nom d'hote
demande hostnamectl, la locale ne prend qu'a la prochaine session, et le mode
de connexion touche sssd et PAM. C'est un chantier a part, a tester en VM.
La frontiere est ici pour qu'elle soit lisible, pas parce qu'on l'a oubliee.

UNE exception, les postes partages (bloc « seat », bf_policy 18.0.2.12.0) : qui
peut ouvrir une session sur un poste prete change a chaque pret, sans
reinstallation. Sur ces postes-la, et sur eux seuls, sssd.conf est reecrit
quand ses regles d'acces changent, puis sssd est relance. Un poste personnel
n'est pas touche.

⚠️ CE QUE LA MINUTERIE AMONT NE FAIT PAS
system-flatpak-setup.timer est en `OnBootSec=30` : elle ne passe QU'AU
DEMARRAGE. Une machine allumee toute la semaine ne convergerait donc jamais,
meme les listes reecrites. Quand les listes changent, on declenche donc
nous-memes system-flatpak-setup.service. Quand elles ne changent pas, on ne
declenche rien : inutile de reveiller un `flatpak install` tous les jours.

⚠️ RETIRER UNE APP DE LA LISTE « install » NE LA DESINSTALLE PAS
system-flatpak-setup ne desinstalle que ce qui figure dans la liste `remove`.
Une application retiree des « Default apps » cesse d'etre installee sur les
machines neuves, mais reste en place sur celles qui l'ont deja. Pour la retirer
partout, la mettre dans « Apps to remove » cote Odoo — d'ou le champ.

TOLERANCE AUX PANNES
Un poste hors ligne, un serveur qui repond mal, une machine revoquee : le
service journalise et sort en succes en gardant la derniere politique connue.
Un poste ne doit jamais se retrouver sans configuration parce que la
synchronisation a echoue. Seules les pannes locales (impossible d'ecrire,
module manquant dans l'image) sortent en echec, parce qu'elles, il faut les voir.

stdlib uniquement : cette image n'embarque pas de dependances python tierces.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

MACHINE_JSON = "/etc/bluefox/machine.json"
PROVISIONING_JSON = "/var/lib/bluefox-welcome/provisioning.json"
STATE_JSON = "/var/lib/bluefox-welcome/policy-sync.json"
FLATPAK_DIR = "/etc/bluebuild/default-flatpaks/system"
SSSD_CONF = "/etc/sssd/sssd.conf"
# Copie de install/bfos_apply.py posee dans l'image par scripts/publish-image.sh.
# Une seule source pour le format des listes : le fichier ecrit a l'installation
# et celui ecrit par la synchronisation ne peuvent pas diverger.
APPLY_MODULE = "/usr/lib/bluefox/bfos_apply.py"
# Le fichier que lit l'ecran de verrouillage, et sa base intacte dans l'image
# (ostree range le /etc de l'image sous /usr/etc). Voir apply_screen_lock.
LOCK_PATH = "/etc/xdg/kscreenlockerrc"
LOCK_BASE = "/usr/etc/xdg/kscreenlockerrc"
AUTH_PREFIX = "bfos-machine "
TIMEOUT = 30


def log(msg):
    print(f"[policy-sync] {msg}", file=sys.stderr, flush=True)


# ------------------------------------------------------------------- lecture
def read_machine(path):
    """Lit le fichier d'enrolement. Retourne None si la machine n'est pas
    enrolee — cas normal d'un poste installe avant l'enrolement, ou dont
    l'enrolement avait echoue : rien a synchroniser, et ce n'est pas une panne."""
    try:
        with open(path) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        log(f"{path} illisible ({exc})")
        return None
    if not isinstance(data, dict) or not data.get("token") or not data.get("endpoint"):
        log(f"{path} incomplet : ni jeton ni endpoint exploitable")
        return None
    return data


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse de suivre une redirection.

    ⚠️ urllib recopie l'en-tete Authorization sur l'URL de destination. Un
    portail captif — le cas normal d'un portable dans un hotel ou un aeroport —
    repond justement par une redirection : suivre celle-la remettrait le secret
    de la machine au portail. En TLS le portail ne peut pas se faire passer pour
    le serveur, donc la connexion echoue d'elle-meme ; ce garde-fou couvre le
    reste, et une redirection legitime de notre propre plan de politique n'a
    aucune raison d'exister."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _is_local(url) -> bool:
    host = (urllib.parse.urlsplit(url).hostname or "").lower()
    return host in ("localhost", "127.0.0.1", "::1")


def fetch_policy(endpoint, token, opener=None):
    """Retourne ``(policy, note)``. `policy` est None quand la politique n'a pas
    pu etre obtenue ; `note` dit pourquoi, en clair, pour le journal."""
    if not endpoint.startswith("https://") and not _is_local(endpoint):
        # Le jeton de la machine ne part pas en clair. La seule exception est la
        # boucle locale, qui sert aux essais.
        return None, f"endpoint non chiffre refuse : {endpoint}"
    req = urllib.request.Request(endpoint)
    req.add_header("Authorization", f"Bearer {AUTH_PREFIX}{token}")
    req.add_header("Accept", "application/json")
    open_url = opener or urllib.request.build_opener(_NoRedirect()).open
    try:
        with open_url(req, timeout=TIMEOUT) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            # Geste administratif deliberé : machine revoquee, ou usager sorti
            # du groupe autorise. On garde la derniere politique connue.
            return None, (f"acces refuse (HTTP {exc.code}) — machine revoquee ou "
                          "usager non autorise ; politique locale conservee")
        return None, f"le serveur a repondu HTTP {exc.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return None, f"serveur injoignable ({exc}) — poste hors ligne ?"
    try:
        policy = json.loads(raw)
    except ValueError as exc:
        return None, f"reponse illisible ({exc})"
    if not (isinstance(policy, dict) and policy.get("schema") == "bf-policy/v2"
            and isinstance(policy.get("install"), dict)):
        return None, "reponse hors schema bf-policy/v2"
    return policy, "ok"


# ------------------------------------------------------------------ ecriture
def atomic_write(path, content, mode=0o644):
    """Ecriture atomique : fichier temporaire puis os.replace. Une coupure de
    courant au mauvais moment laisse l'ancien fichier intact plutot qu'un JSON
    tronque, que plus rien ne saurait relire.

    Le mode est pose A LA CREATION du temporaire, pas apres. L'atomicite du
    rename ne dit rien des permissions : avec un chmod posterieur, le fichier
    appele avec mode=0o600 — la politique, qui porte le login de l'operateur —
    existait d'abord en 0644 sous un nom previsible, dans le repertoire de
    destination. Le rename n'y changeait rien, il arrivait apres."""
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    tmp = os.path.join(directory, f".{os.path.basename(path)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        os.fchmod(fd, mode)  # temporaire deja present : O_CREAT ignore le mode
        fh = os.fdopen(fd, "w")
    except BaseException:
        os.close(fd)
        raise
    with fh:
        fh.write(content)
    os.replace(tmp, path)


def write_if_changed(path, content, mode=0o644) -> bool:
    """Ecrit `content` seulement s'il differe de ce qui est deja la. Retourne
    True si le fichier a change."""
    try:
        with open(path) as fh:
            if fh.read() == content:
                return False
    except (OSError, ValueError):
        pass
    atomic_write(path, content, mode)
    return True


def _comparable(policy):
    """La politique debarrassee de ce qui change a chaque appel.

    ⚠️ `generated_at` est horodate par le serveur A CHAQUE reponse. Comparer les
    fichiers octet a octet ferait donc conclure « la politique a change » tous
    les jours, sur toutes les machines : le journal mentirait, le fichier
    changerait de date pour rien, et toute logique branchee plus tard sur « la
    politique a change » se declencherait a chaque passage."""
    return {k: v for k, v in policy.items() if k != "generated_at"}


def write_policy(path, policy) -> bool:
    """Ecrit la politique si son CONTENU a change. Retourne True si oui."""
    try:
        with open(path) as fh:
            current = json.load(fh)
        if isinstance(current, dict) and _comparable(current) == _comparable(policy):
            return False
    except (OSError, ValueError):
        pass
    # 0600 : la politique porte le login de l'operateur et les endpoints LDAP.
    atomic_write(path, json.dumps(policy, indent=2) + "\n", mode=0o600)
    return True


def write_public(path, policy, apply_mod) -> bool:
    """Ecrit la copie expurgee si son CONTENU a change (meme regle que
    write_policy : `generated_at` seul n'est pas un changement)."""
    content = apply_mod.render_public_policy(policy)
    try:
        with open(path) as fh:
            current = json.load(fh)
        if isinstance(current, dict) and _comparable(current) == _comparable(json.loads(content)):
            return False
    except (OSError, ValueError):
        pass
    atomic_write(path, content, mode=0o644)
    return True


def load_apply(path=APPLY_MODULE):
    """Charge la copie de bfos_apply.py posee dans l'image, pour reutiliser son
    rendu des listes Flatpak. Retourne None si elle manque."""
    import importlib.util

    if not os.path.exists(path):
        return None
    spec = importlib.util.spec_from_file_location("bfos_apply", path)
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def apply_apps(policy, apply_mod, flatpak_dir=FLATPAK_DIR) -> tuple:
    """Reecrit les deux listes Flatpak. Retourne ``(changed, detail)``.

    ⚠️ Difference VOULUE avec l'application a l'installation : ici on ecrit les
    deux fichiers meme quand une liste est VIDE. A l'installation, une liste
    vide ne fait rien ecrire, ce qui laisse la base de l'image telle quelle —
    c'est le bon comportement pour un systeme neuf. En synchronisation, ne pas
    ecrire laisserait la liste PRECEDENTE en place : vider les applications
    supplementaires cote Odoo n'aurait alors aucun effet, et la politique ne
    serait plus la source de verite. Une politique SANS bloc « apps » (serveur
    anterieur a bf_policy 18.0.2.3.0) ne fait toujours rien ecrire, elle."""
    apps = policy.get("apps")
    if not isinstance(apps, dict):
        return False, "politique sans bloc apps — listes laissees intactes"
    changed = []
    for key in ("install", "remove"):
        ids = [str(a).strip() for a in (apps.get(key) or []) if str(a).strip()]
        content = apply_mod.render_flatpak_list(ids, key)
        if write_if_changed(os.path.join(flatpak_dir, key), content):
            changed.append(f"{key}={len(ids)}")
    if not changed:
        return False, "listes Flatpak inchangees"
    return True, "listes Flatpak reecrites (" + ", ".join(changed) + ")"


def trigger_flatpak_setup(run=subprocess.run) -> bool:
    """Declenche la convergence des applications tout de suite.

    Necessaire parce que system-flatpak-setup.timer est en OnBootSec=30 : sans
    ce coup de pouce, une machine allumee en continu n'appliquerait la nouvelle
    liste qu'a son prochain demarrage."""
    try:
        run(["systemctl", "start", "--no-block", "system-flatpak-setup.service"],
            check=False)
        return True
    except OSError as exc:
        log(f"declenchement de system-flatpak-setup impossible ({exc})")
        return False


# ------------------------------------------------------ verrouillage d'ecran
# Bornes de policies.auto_lock_minutes : 0 = non impose (la personne regle son
# poste elle-meme), 1 a 1440 = verrouillage impose apres n minutes. La meme
# borne est posee cote Odoo ; elle est reverifiee ici parce qu'une valeur
# aberrante ne doit jamais devenir un reglage du poste.
LOCK_MAX_MINUTES = 1440
LOCK_BEGIN = ("# >>> bluefox-policy-sync : verrouillage impose par la politique "
              "(policies.auto_lock_minutes), ne pas modifier")
LOCK_END = "# <<< bluefox-policy-sync"


def _lock_minutes(policy):
    """Retourne ``(minutes, note)``. `minutes` est None quand la politique ne
    dit rien d'exploitable : le fichier est alors laisse tel quel.

    ⚠️ Une cle ABSENTE n'est pas un 0. Absente, c'est un serveur anterieur ou
    une politique incomplete : on garde le dernier reglage connu. 0, c'est une
    decision de l'organisation : ne plus rien imposer."""
    pol = policy.get("policies")
    if not isinstance(pol, dict) or "auto_lock_minutes" not in pol:
        return None, "politique sans auto_lock_minutes, verrouillage laisse intact"
    value = pol["auto_lock_minutes"]
    # bool est un int en Python : sans ce test, `true` deviendrait 1 minute.
    if isinstance(value, bool) or not isinstance(value, int):
        return None, (f"auto_lock_minutes non entier ({value!r}), "
                      "verrouillage laisse intact")
    if not 0 <= value <= LOCK_MAX_MINUTES:
        return None, (f"auto_lock_minutes hors bornes ({value}, attendu 0 a "
                      f"{LOCK_MAX_MINUTES}), verrouillage laisse intact")
    return value, ""


def _lock_block(minutes) -> str:
    """Le bloc impose, groupe [Daemon] de kscreenlockerrc (Plasma 6).

    Cles et unites relues dans kscreenlocker (settings/kscreenlockersettings.kcfg
    et ksldapp.cpp, v6.7.5) : Timeout est en MINUTES (Double), LockGrace en
    SECONDES. `[$i]` rend le groupe immuable : KConfig ignore alors le groupe
    [Daemon] du ~/.config/kscreenlockerrc de la personne, et le module des
    Parametres grise les reglages.

    Lock et RequirePassword sont imposes aussi : chacun, a faux, fait demarrer
    l'ecran de verrouillage en `--nolock` (un economiseur que le premier
    mouvement de souris leve). LockGrace aussi : c'est le delai pendant lequel
    un mouvement deverrouille sans mot de passe ; laisse libre, une grande
    valeur vaudrait de ne jamais verrouiller."""
    return (f"{LOCK_BEGIN}\n"
            "[Daemon][$i]\n"
            "Autolock=true\n"
            f"Timeout={minutes}\n"
            "Lock=true\n"
            "LockGrace=5\n"
            "LockOnResume=true\n"
            "RequirePassword=true\n"
            f"{LOCK_END}\n")


def _strip_lock(text, all_daemon) -> str:
    """Retire de `text` le bloc balise de ce service et, si `all_daemon`, tout
    groupe [Daemon] (y compris ses sous-groupes et sa forme [Daemon][$i])."""
    out = []
    # Commentaires et lignes vides lus dans un groupe retire : ils precedent
    # souvent le groupe SUIVANT (l'en-tete du fond, par exemple). On les garde
    # en attente et on ne les rend que si ce groupe suivant est conserve.
    pending = []
    in_ours = in_daemon = False
    for line in text.splitlines(keepends=True):
        s = line.strip()
        if s == LOCK_BEGIN:
            in_ours = True
            continue
        is_header = s.startswith("[")
        first = s[1:].split("]", 1)[0] if is_header else None
        if in_ours:
            if s == LOCK_END:
                in_ours = False
                continue
            # Bloc tronque (fin de balise perdue) : il s'arrete au premier
            # groupe qui n'est plus le sien, pour ne pas avaler la suite.
            if not (is_header and first != "Daemon"):
                continue
            in_ours = False
        if s == LOCK_END:
            continue
        if is_header:
            in_daemon = all_daemon and first == "Daemon"
            if not in_daemon:
                out.extend(pending)
            pending = []
        if in_daemon:
            if not s or s.startswith(("#", ";")):
                pending.append(line)
            continue
        out.append(line)
    return "".join(out)


def render_screen_lock(source, minutes) -> str:
    """`source` sans aucun [Daemon], puis le bloc impose. Le fond de l'ecran de
    verrouillage ([Greeter], ecrit par generate_kde_theme.py) est conserve."""
    body = _strip_lock(source, all_daemon=True).rstrip("\n")
    return (body + "\n\n" if body else "") + _lock_block(minutes)


def _rendered_by_us(text) -> bool:
    """Vrai si `text` est exactement ce que ce service ecrit : un contenu sans
    [Daemon] suivi de son bloc, pour une duree valide. Le fond peut avoir
    change (mise a jour de l'image) sans que ce soit une alteration locale."""
    import re

    m = re.search(r"^Timeout=(\d+)$", text, re.M)
    if not m or not 1 <= int(m.group(1)) <= LOCK_MAX_MINUTES:
        return False
    return text == render_screen_lock(text, int(m.group(1)))


def _pristine(current, base_text) -> bool:
    """Vrai si le fichier en place n'a jamais recu de reglage de verrouillage :
    c'est la base de l'image, ou (sans base) un fichier sans aucun [Daemon]."""
    if base_text is not None:
        return current == base_text
    return _strip_lock(current, all_daemon=True) == current


def _read_text(path):
    try:
        with open(path) as fh:
            return fh.read()
    except FileNotFoundError:
        return None


def apply_screen_lock(policy, path=None, base=None) -> tuple:
    """Impose le verrouillage d'ecran. Retourne ``(changed, detail, restored)``.

    🔴 PIEGE OSTREE : l'image livre deja /etc/xdg/kscreenlockerrc (le fond de
    l'ecran de verrouillage). Un fichier de /etc modifie localement n'est plus
    mis a jour par l'image : ostree garde la version locale. On regenere donc
    TOUJOURS depuis la base intacte de l'image (/usr/etc/xdg/kscreenlockerrc) :
    le fond d'une nouvelle image revient au passage suivant, et une alteration
    locale du fichier est defaite. Sans base (image qui n'en livre pas), on
    repart du fichier en place et on n'y remplace que son propre bloc.

    0 = non impose : le fichier redevient la base de l'image (ou perd son
    bloc), la personne retrouve ses propres reglages.

    `restored` dit qu'un reglage local a ete ecrase : le fichier en place
    n'etait ni la base ni un rendu de ce service."""
    path = path or LOCK_PATH
    base = base or LOCK_BASE
    minutes, note = _lock_minutes(policy)
    if minutes is None:
        return False, note, False

    base_text = _read_text(base)
    current = _read_text(path)
    if minutes == 0:
        if base_text is not None:
            content = base_text
        elif current is None:
            return False, "verrouillage non impose (aucun fichier)", False
        else:
            body = _strip_lock(current, all_daemon=False).rstrip("\n")
            content = body + "\n" if body else ""
        what = "verrouillage non impose (reglage de la personne)"
    else:
        source = base_text if base_text is not None else (current or "")
        content = render_screen_lock(source, minutes)
        what = f"verrouillage impose apres {minutes} min"

    restored = (current is not None and current != content
                and not _rendered_by_us(current)
                and not _pristine(current, base_text))
    if not write_if_changed(path, content, 0o644):
        return False, what + ", inchange", False
    if restored:
        what += ", reglage local retabli"
    return True, what, restored


def _authtok_en_place(sssd_conf):
    """Le mot de passe de liaison du sssd.conf en place, ou "" s'il n'y en a pas."""
    try:
        with open(sssd_conf) as fh:
            for line in fh:
                cle, sep, valeur = line.partition("=")
                if sep and cle.strip() == "ldap_default_authtok":
                    return valeur.strip()
    except (OSError, ValueError):
        pass
    return ""


def apply_seat_access(policy, apply_mod, sssd_conf=SSSD_CONF, run=subprocess.run):
    """Poste partage : reecrit sssd.conf si ses regles d'acces ont change.

    Rend (change, detail). Ne touche a rien hors d'un poste partage en mode
    sssd avec un annuaire complet : un fichier rendu sans ldap_uri ou sans
    identite de liaison donnerait un poste sans AUCUNE session, pire que de
    garder l'ancien emprunteur un jour de plus.

    ⚠️ Depuis bf_policy 18.0.2.11.2, /machine ne sert plus le mot de passe de
    liaison : il ne passe sur le reseau qu'a l'installation (/me, jeton du
    client d'installation). Rendre sssd.conf depuis cette reponse effacait
    ldap_default_authtok a la premiere synchro horaire, et l'avant-poste
    refusait ensuite la liaison : plus aucune session, labo comme pret. Le
    mot de passe se reprend donc du fichier en place quand la politique n'en
    porte pas, et sans mot de passe nulle part le fichier reste tel quel.
    """
    if not isinstance(policy.get("seat"), dict):
        return False, "poste personnel : acces inchange"
    install = policy.get("install") or {}
    login = install.get("login") or {}
    if login.get("mode") != "sssd" or not (login.get("ldap_uri") and login.get("bind_dn")):
        return False, "poste partage sans annuaire complet : sssd.conf conserve"
    if not login.get("bind_password"):
        en_place = _authtok_en_place(sssd_conf)
        if not en_place:
            return False, "poste partage sans mot de passe de liaison : sssd.conf conserve"
        policy = dict(policy, install=dict(install, login=dict(login, bind_password=en_place)))
    if not write_if_changed(sssd_conf, apply_mod.render_sssd_conf(policy), mode=0o600):
        return False, "acces du poste inchange"
    # Le cache garderait l'ancienne decision d'acces jusqu'a son expiration.
    run(["sss_cache", "-E"], check=False)
    run(["systemctl", "try-restart", "sssd.service"], check=False)
    return True, "acces du poste mis a jour"


def write_state(path, **fields):
    """Trace de la derniere synchronisation, pour le diagnostic a froid."""
    try:
        write_if_changed(path, json.dumps(fields, indent=2, sort_keys=True) + "\n")
    except OSError as exc:
        log(f"etat non ecrit ({exc})")


# ---------------------------------------------------------------------- main
def sync(machine_path=MACHINE_JSON, provisioning_path=PROVISIONING_JSON,
         flatpak_dir=FLATPAK_DIR, state_path=STATE_JSON,
         apply_module=APPLY_MODULE, opener=None, run=subprocess.run,
         trigger=True, public_path=None, sssd_conf=None,
         lock_path=LOCK_PATH, lock_base=LOCK_BASE) -> int:
    machine = read_machine(machine_path)
    if machine is None:
        log("machine non enrolee — rien a synchroniser")
        return 0

    policy, note = fetch_policy(machine["endpoint"], machine["token"],
                                opener=opener)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if policy is None:
        log(note)
        write_state(state_path, last_attempt=stamp, status="skipped", detail=note,
                    machine_uuid=machine.get("machine_uuid", ""))
        return 0

    rc = 0
    changes = []
    try:
        if write_policy(provisioning_path, policy):
            changes.append("politique")
    except OSError as exc:
        # Panne locale : celle-la doit se voir dans `systemctl status`.
        log(f"ecriture de {provisioning_path} impossible ({exc})")
        write_state(state_path, last_attempt=stamp, status="error", detail=str(exc),
                    machine_uuid=machine.get("machine_uuid", ""))
        return 1

    apply_mod = load_apply(apply_module)
    if apply_mod is None:
        log(f"{apply_module} absent de l'image — applications non synchronisees")
        rc = 1
    else:
        try:
            apps_changed, detail = apply_apps(policy, apply_mod, flatpak_dir)
        except OSError as exc:
            log(f"ecriture des listes Flatpak impossible ({exc})")
            apps_changed, detail, rc = False, str(exc), 1
        log(detail)
        if apps_changed:
            changes.append("applications")
            if trigger:
                trigger_flatpak_setup(run=run)
        try:
            access_changed, detail = apply_seat_access(
                policy, apply_mod, sssd_conf=sssd_conf or SSSD_CONF, run=run)
        except OSError as exc:
            log(f"ecriture de sssd.conf impossible ({exc})")
            access_changed, detail, rc = False, str(exc), 1
        log(detail)
        if access_changed:
            changes.append("acces du poste")
        try:
            if write_public(public_path or apply_mod.PUBLIC_JSON, policy, apply_mod):
                changes.append("copie de session")
        except OSError as exc:
            log(f"ecriture de la copie de session impossible ({exc})")
            rc = 1

    # Independant de bfos_apply.py : le verrouillage s'applique meme si le
    # module manque a l'image.
    try:
        lock_changed, detail_lock, restored = apply_screen_lock(
            policy, lock_path, lock_base)
    except OSError as exc:
        log(f"ecriture de {lock_path} impossible ({exc})")
        lock_changed, detail_lock, restored, rc = False, str(exc), False, 1
    log(detail_lock)
    if lock_changed:
        changes.append("verrouillage (reglage local retabli)" if restored
                       else "verrouillage")

    log("aucun changement" if not changes
        else "applique : " + ", ".join(changes))
    write_state(state_path, last_attempt=stamp, last_success=stamp,
                status="ok" if rc == 0 else "partial",
                changes=changes, machine_uuid=machine.get("machine_uuid", ""),
                hostname=machine.get("hostname", ""), screen_lock=detail_lock)
    return rc


def main(argv=None):
    if os.geteuid() != 0:
        log("doit tourner en root")
        return 1
    return sync()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
