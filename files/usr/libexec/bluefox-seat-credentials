#!/usr/bin/env python3
"""Remet les identifiants Nextcloud a l'usager du siege, une fois.

POURQUOI CE DETOUR
Le %pre frappe le mot de passe d'application Nextcloud pendant que le porteur
de l'operateur vaut encore, et le %post le depose en 0600 root. Mais l'agent
d'accueil tourne EN TANT QUE l'usager : il ne peut pas le lire. Et on ne peut
pas le deposer directement au bon proprietaire, parce qu'en mode sssd l'uid
vient de l'annuaire — il n'existe pas encore au moment de l'installation.

Le premier demarrage est le premier instant ou getent peut repondre. On y
remet donc le fichier a son destinataire, en 0600. Un 0644 « en attendant »
l'exposerait a tout compte de la machine, y compris celui de secours.

Ne fait rien, et sort en succes, quand il n'y a rien a remettre : un poste
sans identifiants stages est un poste qui fera son SSO au premier demarrage,
ce qui marche depuis le debut.
"""
import json
import os
import pwd
import sys

FICHIER = "/var/lib/bluefox-welcome/nc-credentials.json"
POLITIQUE = "/var/lib/bluefox-welcome/provisioning.json"


def _siege():
    """Le login du siege, tel que la politique le porte, reduit a sa partie
    locale : l'annuaire sert « olivier », la politique « olivier@exemple »."""
    try:
        with open(POLITIQUE, encoding="utf-8") as fh:
            politique = json.load(fh)
    except Exception as exc:  # noqa: BLE001
        print(f"politique illisible ({exc})", file=sys.stderr)
        return ""
    login = ((politique.get("user") or {}).get("login") or "")
    return login.split("@")[0]


def main():
    if not os.path.exists(FICHIER):
        print("aucun identifiant stage — rien a remettre")
        return 0

    nom = _siege()
    if not nom:
        print("aucun usager de siege dans la politique ; fichier laisse en "
              "0600 root", file=sys.stderr)
        return 0

    try:
        # getent, pas une supposition : c'est l'annuaire qui decide de l'uid,
        # et de la casse du nom.
        infos = pwd.getpwnam(nom)
    except KeyError:
        print(f"l'usager {nom!r} n'est pas encore resolvable ; nouvel essai "
              "au prochain demarrage", file=sys.stderr)
        return 0

    try:
        os.chown(FICHIER, infos.pw_uid, infos.pw_gid)
        os.chmod(FICHIER, 0o600)
    except OSError as exc:
        print(f"remise impossible ({exc})", file=sys.stderr)
        return 1

    print(f"identifiants Nextcloud remis a {nom} "
          f"(uid {infos.pw_uid}), en 0600")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
