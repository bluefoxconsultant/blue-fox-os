#!/usr/bin/env python3
"""Remet les identifiants Nextcloud a l'usager du siege, une fois.

POURQUOI CE DETOUR
Le %pre frappe le mot de passe d'application Nextcloud pendant que le porteur
de l'operateur vaut encore, et le %post le depose en 0600 root. Mais l'agent
d'accueil tourne EN TANT QUE l'usager : il ne peut pas le lire. Et on ne peut
pas le deposer directement au bon proprietaire, parce qu'en mode sssd l'uid
vient de l'annuaire — il n'existe pas encore au moment de l'installation.

Le premier demarrage est le premier instant ou getent peut repondre. On y
remet donc le fichier a son destinataire, en 0600. Un 0644 « en attendant »
l'exposerait a tout compte de la machine, y compris celui de secours.

Ne fait rien, et sort en succes, quand il n'y a rien a remettre : un poste
sans identifiants stages est un poste qui fera son SSO au premier demarrage,
ce qui marche depuis le debut.
"""
import base64
import json
import os
import pwd
import sys
import urllib.request

FICHIER = "/var/lib/bluefox-welcome/nc-credentials.json"
POLITIQUE = "/var/lib/bluefox-welcome/provisioning.json"


def _politique():
    """La politique stagee, ou None si elle est absente ou illisible."""
    try:
        with open(POLITIQUE, encoding="utf-8") as fh:
            politique = json.load(fh)
    except Exception as exc:  # noqa: BLE001
        print(f"politique illisible ({exc})", file=sys.stderr)
        return None
    return politique if isinstance(politique, dict) else None


def _revoquer():
    """Revoque, au mieux, le mot de passe d'application stage (#28055).

    Il est au nom de l'operateur qui a autorise l'installation, pas d'un
    emprunteur : l'effacer sur le disque ne suffit pas, il resterait valide
    dans Nextcloud. Le mot de passe se revoque lui-meme
    (DELETE /ocs/v2.php/core/apppassword). Au mieux : sans reseau, ou sur un
    refus, on efface quand meme et on dit qu'il reste a le faire a la main.
    Jamais en http : on n'envoie pas un mot de passe en clair.
    """
    try:
        with open(FICHIER, encoding="utf-8") as fh:
            ident = json.load(fh)
        url = (ident.get("url") or "").rstrip("/")
        login, mdp = ident.get("login") or "", ident.get("app_password") or ""
    except Exception as exc:  # noqa: BLE001
        return f"illisible ({exc.__class__.__name__})"
    if not (url.startswith("https://") and login and mdp):
        return "rien a revoquer (adresse https, login ou mot de passe absents)"
    jeton = base64.b64encode(f"{login}:{mdp}".encode()).decode()
    req = urllib.request.Request(
        f"{url}/ocs/v2.php/core/apppassword", method="DELETE",
        headers={"Authorization": f"Basic {jeton}", "OCS-APIRequest": "true"})
    try:
        with urllib.request.urlopen(req, timeout=10) as rep:
            code = rep.status
    except Exception as exc:  # noqa: BLE001
        code = getattr(exc, "code", None) or exc.__class__.__name__
    if code == 200:
        return "revoque dans Nextcloud"
    return (f"NON revoque ({code}) : a retirer dans Nextcloud, appareil "
            f"« Blue Fox OS (poste de siege) » de {login}")


def _siege(politique):
    """Le login du siege, tel que la politique le porte, reduit a sa partie
    locale : l'annuaire sert « olivier », la politique « olivier@exemple »."""
    login = ((politique.get("user") or {}).get("login") or "")
    return login.split("@")[0]


def main():
    if not os.path.exists(FICHIER):
        print("aucun identifiant stage — rien a remettre")
        return 0

    politique = _politique()
    if politique is None:
        # Rien de sur a decider : on ne remet pas, on n'efface pas. Le service
        # repasse au prochain demarrage.
        return 0

    # 🔴 Poste partage (#28055). Les installations v1.0.2 frappaient le mot de
    # passe d'application de l'OPERATEUR qui autorisait l'installation, et le
    # deposaient ici. Il n'a pas de destinataire sur un poste de labo ou de
    # pret, et le garder, c'est garder sur un poste partage la cle d'un compte
    # qui n'est pas celui des emprunteurs. On l'efface ; sa revocation, elle,
    # se fait dans Nextcloud (appareil « Blue Fox OS (poste de siege) »).
    if isinstance(politique.get("seat"), dict):
        revocation = _revoquer()
        try:
            os.remove(FICHIER)
        except OSError as exc:
            print(f"poste partage : effacement impossible ({exc})",
                  file=sys.stderr)
            return 1
        print("poste partage : identifiants Nextcloud de l'operateur effaces, "
              f"rien a remettre ; {revocation}")
        return 0

    nom = _siege(politique)
    if not nom:
        print("aucun usager de siege dans la politique ; fichier laisse en "
              "0600 root", file=sys.stderr)
        return 0

    try:
        # getent, pas une supposition : c'est l'annuaire qui decide de l'uid,
        # et de la casse du nom.
        infos = pwd.getpwnam(nom)
    except KeyError:
        print(f"l'usager {nom!r} n'est pas encore resolvable ; nouvel essai "
              "au prochain demarrage", file=sys.stderr)
        return 0

    try:
        os.chown(FICHIER, infos.pw_uid, infos.pw_gid)
        os.chmod(FICHIER, 0o600)
    except OSError as exc:
        print(f"remise impossible ({exc})", file=sys.stderr)
        return 1

    print(f"identifiants Nextcloud remis a {nom} "
          f"(uid {infos.pw_uid}), en 0600")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
