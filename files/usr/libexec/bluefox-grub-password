#!/usr/bin/env python3
"""bluefox-grub-password : verrouille l'edition de GRUB avec la phrase du disque.

POURQUOI (#28058)
Le TPM n'est lie qu'au PCR 7 (etat du Secure Boot), qui ne mesure PAS la ligne
de noyau. Sans mot de passe GRUB, quiconque est devant la machine presse « e »,
ajoute init=/bin/bash, et l'initramfs deverrouille le disque par le TPM : shell
root sans la phrase. Avec un superusager GRUB, on demarre toujours sans rien
taper (les entrees BLS n'ont pas de grub_users, donc pas de restriction), mais
editer une entree ou ouvrir la console GRUB demande le mot de passe.

POURQUOI LA PHRASE DU DISQUE
Meme arbitrage que le compte de secours (2026-09-11) : un seul secret, deja
sequestre, revelable par le seul groupe qui en a le droit, trace
nominativement. Qui l'a ouvre deja le disque : GRUB n'ajoute aucun risque.
/boot n'est pas chiffre et n'en garde qu'une empreinte PBKDF2 ; la phrase tiree
par l'installateur porte ~122 bits, hors de portee d'une attaque hors ligne.

USAGES
  sudo /usr/libexec/bluefox-grub-password
                                         poste deja installe (v1.0.2) : coller
                                         la phrase revelee au sequestre. Elle est
                                         d'abord essayee sur le volume LUKS.
  ... | bluefox-grub-password --deja-verifiee
                                         bluefox-tpm-enroll, juste apres un
                                         enrolement reussi (la phrase vient
                                         d'ouvrir le volume).
  bluefox-grub-password --etat           « verrouille » (code 0) ou « ouvert »
                                         (code 1).

La phrase arrive par l'entree standard, jamais en argument : la ligne de
commande d'un processus est lisible par tous.

⚠️ Le %post du kickstart pose le meme fichier a l'installation, avec sa propre
copie de empreinte() : l'image installee n'est pas executable depuis
l'installateur. Un essai verifie que les deux produisent une empreinte que
verifier() accepte.
"""

import getpass
import hashlib
import os
import re
import subprocess
import sys

GRUB_DIR = os.environ.get("BFOS_GRUB_DIR", "/boot/grub2")
CRYPTTAB = os.environ.get("BFOS_CRYPTTAB", "/etc/crypttab")
ITERATIONS = 10000          # celles de grub2-mkpasswd-pbkdf2
# La forme que tire l'installateur (bfos_provision, alphabet de Crockford sans
# U, 5 groupes de 5, ~122 bits). Seule celle-la est posee : une phrase choisie
# par une personne serait attaquable hors ligne depuis l'empreinte de /boot
# (PBKDF2 bien plus rapide a essayer que l'argon2id de LUKS), elle n'est pas
# au sequestre, et GRUB ne sait taper que l'ASCII imprimable selon la
# disposition du micrologiciel (relecture adverse, #28058).
FORME = re.compile(r"^[2-9A-HJKMNP-TV-Z]{5}(-[2-9A-HJKMNP-TV-Z]{5}){4}$")


def empreinte(phrase, sel=None):
    """La forme que lit password_pbkdf2 : celle de grub2-mkpasswd-pbkdf2."""
    sel = sel if sel is not None else os.urandom(64)
    h = hashlib.pbkdf2_hmac("sha512", phrase.encode(), sel, ITERATIONS, 64)
    return f"grub.pbkdf2.sha512.{ITERATIONS}.{sel.hex().upper()}.{h.hex().upper()}"


def verifier(phrase, valeur):
    parts = valeur.strip().split(".")
    if len(parts) != 6 or parts[:3] != ["grub", "pbkdf2", "sha512"]:
        return False
    it, sel, h = parts[3:]
    try:
        sel_b, h_b = bytes.fromhex(sel), bytes.fromhex(h)
        calc = hashlib.pbkdf2_hmac("sha512", phrase.encode(), sel_b, int(it), len(h_b))
    except ValueError:
        return False
    return calc == h_b


def _fichier():
    return os.path.join(GRUB_DIR, "user.cfg")


def etat():
    try:
        with open(_fichier()) as f:
            return any(l.strip().startswith("GRUB2_PASSWORD=grub.pbkdf2.") for l in f)
    except OSError:
        return False


def _volume():
    with open(CRYPTTAB) as f:
        for ligne in f:
            champs = ligne.split()
            if champs and not champs[0].startswith("#") and len(champs) >= 2:
                src = champs[1]
                return ("/dev/disk/by-uuid/" + src[5:]) if src.startswith("UUID=") else src
    return None


def ouvre_le_disque(phrase):
    dev = _volume()
    if not dev:
        return False
    # 🔴 --disable-external-tokens : sans lui, cryptsetup essaie d'abord le
    # jeton systemd-tpm2 (sans NIP) et rend 0 QUELLE QUE SOIT la phrase sur un
    # poste enrole (relecture adverse, #28058). GRUB serait alors verrouille
    # par un secret que personne ne connait.
    r = subprocess.run(["cryptsetup", "open", "--test-passphrase", "--disable-external-tokens",
                        "--key-file=-", dev],
                       input=phrase.encode(), capture_output=True, check=False)
    return r.returncode == 0


def _ecrire(contenu):
    tmp = _fichier() + ".bfos-tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(contenu)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, _fichier())
    d = os.open(GRUB_DIR, os.O_RDONLY)
    try:
        os.fsync(d)
    finally:
        os.close(d)


def poser(phrase):
    contenu = f"GRUB2_PASSWORD={empreinte(phrase)}\n"
    try:
        _ecrire(contenu)
        return
    except OSError as e:
        if e.errno != 30:          # EROFS : /boot monte en lecture seule
            raise
    subprocess.run(["mount", "-o", "remount,rw", "/boot"], check=True)
    try:
        _ecrire(contenu)
    finally:
        if subprocess.run(["mount", "-o", "remount,ro", "/boot"], check=False).returncode:
            print("/boot reste monte en ecriture (remount,ro refuse).", file=sys.stderr)


def _lire_phrase():
    if sys.stdin.isatty():
        a = getpass.getpass("Phrase du disque (revelee au sequestre) : ")
        b = getpass.getpass("Encore une fois : ")
        if a != b:
            print("Les deux saisies different.", file=sys.stderr)
            return ""
        return a
    return sys.stdin.readline().rstrip("\n")


def main(argv):
    if "--etat" in argv:
        verrou = etat()
        print("verrouille" if verrou else "ouvert")
        return 0 if verrou else 1
    if os.geteuid() != 0 and "BFOS_GRUB_DIR" not in os.environ:
        print("A lancer en root : sudo /usr/libexec/bluefox-grub-password", file=sys.stderr)
        return 2
    phrase = _lire_phrase()
    if not phrase:
        print("Aucune phrase : rien n'est pose.", file=sys.stderr)
        return 1
    if not FORME.match(phrase):
        print("Cette phrase n'a pas la forme tiree par l'installateur (5 groupes de 5) : "
              "elle n'est pas au sequestre, et son empreinte sur /boot l'exposerait. "
              "Rien n'est pose.", file=sys.stderr)
        return 3
    if "--deja-verifiee" not in argv and not ouvre_le_disque(phrase):
        print("Cette phrase n'ouvre pas le disque : rien n'est pose.", file=sys.stderr)
        return 1
    if not os.path.isdir(GRUB_DIR):
        print(f"{GRUB_DIR} introuvable : rien n'est pose.", file=sys.stderr)
        return 1
    poser(phrase)
    print(f"Edition de GRUB verrouillee ({_fichier()}). Le demarrage ne demande rien.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
