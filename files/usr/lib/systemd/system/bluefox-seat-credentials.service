[Unit]
Description=Blue Fox OS — remise des identifiants Nextcloud au siege
Documentation=https://github.com/bluefoxconsultant/blue-fox-os
# Rien a remettre, rien a demarrer : sans le fichier stage par l'installation
# le service ne tourne meme pas, plutot que de sortir en succes vide a chaque
# demarrage.
ConditionPathExists=/var/lib/bluefox-welcome/nc-credentials.json
# L'uid du siege vient de l'annuaire : il faut que sssd reponde avant que
# getent puisse trancher. Sans ca le service sort proprement sans rien faire
# et reessaie au demarrage suivant — d'ou l'absence de RemainAfterExit.
After=sssd.service nss-user-lookup.target
Wants=sssd.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefox-seat-credentials
StandardOutput=journal
StandardError=journal
RemainAfterExit=no
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
