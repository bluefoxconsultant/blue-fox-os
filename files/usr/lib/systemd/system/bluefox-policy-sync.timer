[Unit]
Description=Minuterie de re-synchronisation de la politique Blue Fox OS
Documentation=https://github.com/bluefoxconsultant/blue-fox-os

[Timer]
# Un passage peu apres le demarrage : c'est le moment ou un poste rallume
# rattrape ce qui a change pendant qu'il dormait.
OnBootSec=3min
# Puis toutes les heures (#26119, decision d'Olivier du 2026-09-27). Un poste
# prete s'ouvre a son emprunteur quand il a relu sa politique : une fois par
# jour, l'eleve reparti avec le portable le jour du pret attendait le
# lendemain. Une requete par poste et par heure, et rien d'autre ne tourne si
# la politique n'a pas change. Persistent=true fait rattraper une echeance
# manquee (portable eteint) au demarrage suivant.
OnCalendar=hourly
Persistent=true
# Etale une flotte sur un quart d'heure : sans ce delai, toutes les machines
# tireraient la politique a la meme seconde. Fixe par machine, pour que chaque
# poste garde un intervalle d'une heure entre deux passages.
RandomizedDelaySec=15min
FixedRandomDelay=true

[Install]
WantedBy=timers.target
