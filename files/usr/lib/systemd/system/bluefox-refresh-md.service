[Unit]
Description=Rafraichissement quotidien de la liste des paquets disponibles
Documentation=https://github.com/bluefoxconsultant/blue-fox-os
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Demande d'Olivier (2026-09-23). Rafraichit le cache des depots rpm : ce que
# `dnf search`, `dnf list --available` et `dnf info` lisent. N'installe rien,
# ne met rien a jour : sur un systeme atomique, les paquets viennent de
# l'image (rpm-ostreed-automatic s'en charge).
ExecStart=/usr/bin/dnf5 makecache --refresh
Nice=10
IOSchedulingClass=idle
